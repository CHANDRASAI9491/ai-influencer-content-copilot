# Environment variables & secrets (CRITICAL: Never commit to Git)
.env
.env.*
!.env.example
*.env
.dev_secret
*.secret
*.pem
*.key
*.cert
*.crt

# Database files
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
copilot.db
copilot.db*

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Node & Frontend Build
node_modules/
dist/
dist-ssr/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.oxlintrc.json
*.local

# Logs and databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS-specific files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
