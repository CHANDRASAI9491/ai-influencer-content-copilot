# ==============================================================================
# Environment Configuration Template (DO NOT COMMIT SENSITIVE VALUES)
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# Environment: "development", "test", or "production"
ENVIRONMENT=development

# Authentication Secret:
# In development: Automatically generated if omitted.
# In production: REQUIRED. Generate a strong key using:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database Connection (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///./copilot.db
# DATABASE_URL=postgresql://user:password@localhost:5432/influencer_copilot

# AI Provider: "auto", "gemini", "openai", or "creative_engine"
AI_PROVIDER=auto

# Optional API Keys for LLM Providers (Leave blank to use Intelligent Creative Engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MIN=60
